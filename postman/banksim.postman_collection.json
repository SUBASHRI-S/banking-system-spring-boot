              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{aliceAccountId}}\",\n  \"toAccountNumber\": \"{{bobAccountNumber}}\",\n  \"amount\": \"250.00\",\n  \"description\": \"Rent share\"\n}"
