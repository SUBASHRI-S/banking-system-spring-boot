# Copy to .env (never commit .env). Every value below is FAKE.
DB_USERNAME=bank
DB_PASSWORD=change-me-db-password
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-32-plus-random-characters-0123456789
# Optional: creates an ADMIN user at startup when set. Leave empty for no admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
